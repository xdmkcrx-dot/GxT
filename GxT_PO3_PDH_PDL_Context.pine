//@version=6
// GxT PO3 candle context plus prior-day reference levels.
// Chart-context visuals only; no trading signals or alerts.
// The current higher-timeframe candle is live and can change until it closes.
indicator("GxT PO3 + PDH/PDL Context", shorttitle = "GxT PO3·PD", overlay = true, max_bars_back = 1000, max_lines_count = 30, max_boxes_count = 5, max_labels_count = 5)

// ── Inputs ────────────────────────────────────────────────────────────────
string G_TF = "Timeframe"
string G_CANDLE = "PO3 candle context"
string G_MID = "Midpoint references"
string G_PD = "Prior-day levels"
string G_DIV = "Timeframe dividers"
string G_CLOSE = "Dynamic close reference"

bool autoTf = input.bool(true, "Auto-select timeframe", group = G_TF)
string manualTf = input.string("15", "Manual timeframe", options = ["5", "15", "30", "60", "240", "1D", "1W", "1M"], group = G_TF)
int candleOffset = input.int(0, "PO3 box offset", minval = -50, maxval = 50, group = G_CANDLE)
color bullColor = input.color(color.green, "Bullish body", group = G_CANDLE, inline = "body")
color bearColor = input.color(color.black, "Bearish body", group = G_CANDLE, inline = "body")
color outsideColor = input.color(color.orange, "Outside-close body", group = G_CANDLE)
color candleBorderColor = input.color(color.black, "Border / wick", group = G_CANDLE)
bool showTfLabel = input.bool(true, "Display timeframe label", group = G_CANDLE)

color midpointColor = input.color(color.gray, "Midpoint wick color", group = G_MID)
bool extendMidpoint = input.bool(false, "Extend midpoint left", group = G_MID)
bool showBottomMidpoint = input.bool(true, "Show bottom midpoint", group = G_MID, inline = "mid")
bool showTopMidpoint = input.bool(true, "Show top midpoint", group = G_MID, inline = "mid")
bool showCandleMidpoint = input.bool(false, "Show candle midpoint", group = G_MID)

bool showPDH = input.bool(true, "Show PDH", group = G_PD, inline = "pd")
bool showPDL = input.bool(true, "Show PDL", group = G_PD, inline = "pd")
color pdColor = input.color(color.rgb(86, 128, 190), "PDH / PDL color", group = G_PD)

bool showDividers = input.bool(true, "Show timeframe dividers", group = G_DIV)
int dividerHistory = input.int(4, "Recent dividers", minval = 1, maxval = 20, group = G_DIV)
color dividerColor = input.color(color.new(color.gray, 50), "Divider color", group = G_DIV)

bool showDynamicClose = input.bool(true, "Show next HTF close line", group = G_CLOSE)
color dynamicCloseColor = input.color(color.new(color.white, 20), "Close line color", group = G_CLOSE)

// ── Context timeframe ─────────────────────────────────────────────────────
string autoTfValue = switch timeframe.period
    "1" => "15"
    "3" => "30"
    "5" => "60"
    "15" => "240"
    "60" => "1D"
    "1D" => "1M"
    "1W" => "1M"
    => manualTf
string contextTf = autoTf ? autoTfValue : manualTf
float chartSeconds = timeframe.in_seconds()
float contextSeconds = timeframe.in_seconds(contextTf)
bool validContextTf = not na(chartSeconds) and not na(contextSeconds) and contextSeconds >= chartSeconds
string requestTf = validContextTf ? contextTf : timeframe.period

[currO, currH, currL, currC, prevO, prevH, prevL, prevC, prev2O, prev2H, prev2L, prev2C, prev3O, prev3H, prev3L, prev3C] = request.security(syminfo.tickerid, requestTf, [open, high, low, close, open[1], high[1], low[1], close[1], open[2], high[2], low[2], close[2], open[3], high[3], low[3], close[3]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// ── PDH / PDL: dotted lines start at the prior daily candle close ──────────
[pdh, pdl, priorDayCloseTime] = request.security(syminfo.tickerid, "D", [high[1], low[1], time_close[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
var line pdhLine = na
var line pdlLine = na
var label pdhLabel = na
var label pdlLabel = na
var int pdPeriodStart = na
if barstate.islast and not na(pdh) and not na(pdl) and not na(priorDayCloseTime)
    if na(pdhLine) or priorDayCloseTime != pdPeriodStart
        if not na(pdhLine)
            line.delete(pdhLine)
            line.delete(pdlLine)
            label.delete(pdhLabel)
            label.delete(pdlLabel)
        pdPeriodStart := priorDayCloseTime
        pdhLine := line.new(priorDayCloseTime, pdh, time, pdh, xloc = xloc.bar_time, extend = extend.right, color = pdColor, style = line.style_dotted, width = 1)
        pdlLine := line.new(priorDayCloseTime, pdl, time, pdl, xloc = xloc.bar_time, extend = extend.right, color = pdColor, style = line.style_dotted, width = 1)
        pdhLabel := label.new(time, pdh, "PDH", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(pdColor, 100), textcolor = pdColor, size = size.tiny)
        pdlLabel := label.new(time, pdl, "PDL", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(pdColor, 100), textcolor = pdColor, size = size.tiny)
    line.set_y1(pdhLine, pdh)
    line.set_y2(pdhLine, pdh)
    line.set_y1(pdlLine, pdl)
    line.set_y2(pdlLine, pdl)
    line.set_color(pdhLine, showPDH ? pdColor : color.new(pdColor, 100))
    line.set_color(pdlLine, showPDL ? pdColor : color.new(pdColor, 100))
    label.set_xy(pdhLabel, time, pdh)
    label.set_xy(pdlLabel, time, pdl)
    label.set_textcolor(pdhLabel, showPDH ? pdColor : color.new(pdColor, 100))
    label.set_textcolor(pdlLabel, showPDL ? pdColor : color.new(pdColor, 100))

// ── Persistent PO3 drawings; update existing objects on the last bar ──────
var box body0 = na
var box body1 = na
var box body2 = na
var box body3 = na
var line wick0 = na
var line wick1 = na
var line wick2 = na
var line wick3 = na
var line midpointTopLine = na
var line midpointBottomLine = na
var line midpointCandleLine = na
var label timeframeLabel = na
var line dynamicCloseLine = na
var array<line> dividerLines = array.new<line>()

color color0 = currC >= currO ? bullColor : bearColor
color color1 = prevC >= prevO ? bullColor : bearColor
color color2 = prev2C >= prev2O ? bullColor : bearColor
color color3 = prev3C >= prev3O ? bullColor : bearColor
bool priorOutsideClose = (prevH > prev2H and prevC < prev2H) or (prevL < prev2L and prevC > prev2L)
color displayColor1 = priorOutsideClose ? outsideColor : color1
float midpointTop = prevC >= prevO ? (prevH + prevC) * 0.5 : (prevH + prevO) * 0.5
float midpointBottom = prevC >= prevO ? (prevL + prevO) * 0.5 : (prevL + prevC) * 0.5
float midpointFull = (prevH + prevL) * 0.5
int x0l = bar_index + 13 + candleOffset
int x0r = bar_index + 15 + candleOffset
int x1l = bar_index + 10 + candleOffset
int x1r = bar_index + 12 + candleOffset
int x2l = bar_index + 7 + candleOffset
int x2r = bar_index + 9 + candleOffset
int x3l = bar_index + 4 + candleOffset
int x3r = bar_index + 6 + candleOffset
int midX1 = x1l - (extendMidpoint ? 30 : 0)

if barstate.islast and validContextTf and not na(currO) and not na(prevO) and not na(prev2O) and not na(prev3O)
    if na(body0)
        body0 := box.new(x0l, math.max(currO, currC), x0r, math.min(currO, currC), bgcolor = color0, border_color = candleBorderColor)
        body1 := box.new(x1l, math.max(prevO, prevC), x1r, math.min(prevO, prevC), bgcolor = displayColor1, border_color = candleBorderColor)
        body2 := box.new(x2l, math.max(prev2O, prev2C), x2r, math.min(prev2O, prev2C), bgcolor = color2, border_color = candleBorderColor)
        body3 := box.new(x3l, math.max(prev3O, prev3C), x3r, math.min(prev3O, prev3C), bgcolor = color3, border_color = candleBorderColor)
        wick0 := line.new(int((x0l + x0r) / 2), currH, int((x0l + x0r) / 2), currL, color = candleBorderColor)
        wick1 := line.new(int((x1l + x1r) / 2), prevH, int((x1l + x1r) / 2), prevL, color = candleBorderColor)
        wick2 := line.new(int((x2l + x2r) / 2), prev2H, int((x2l + x2r) / 2), prev2L, color = candleBorderColor)
        wick3 := line.new(int((x3l + x3r) / 2), prev3H, int((x3l + x3r) / 2), prev3L, color = candleBorderColor)
    else
        box.set_lefttop(body0, x0l, math.max(currO, currC))
        box.set_rightbottom(body0, x0r, math.min(currO, currC))
        box.set_bgcolor(body0, color0)
        box.set_lefttop(body1, x1l, math.max(prevO, prevC))
        box.set_rightbottom(body1, x1r, math.min(prevO, prevC))
        box.set_bgcolor(body1, displayColor1)
        box.set_lefttop(body2, x2l, math.max(prev2O, prev2C))
        box.set_rightbottom(body2, x2r, math.min(prev2O, prev2C))
        box.set_bgcolor(body2, color2)
        box.set_lefttop(body3, x3l, math.max(prev3O, prev3C))
        box.set_rightbottom(body3, x3r, math.min(prev3O, prev3C))
        box.set_bgcolor(body3, color3)
        line.set_xy1(wick0, int((x0l + x0r) / 2), currH)
        line.set_xy2(wick0, int((x0l + x0r) / 2), currL)
        line.set_xy1(wick1, int((x1l + x1r) / 2), prevH)
        line.set_xy2(wick1, int((x1l + x1r) / 2), prevL)
        line.set_xy1(wick2, int((x2l + x2r) / 2), prev2H)
        line.set_xy2(wick2, int((x2l + x2r) / 2), prev2L)
        line.set_xy1(wick3, int((x3l + x3r) / 2), prev3H)
        line.set_xy2(wick3, int((x3l + x3r) / 2), prev3L)

    if na(midpointTopLine)
        midpointTopLine := line.new(midX1, midpointTop, x0r, midpointTop, color = midpointColor)
        midpointBottomLine := line.new(midX1, midpointBottom, x0r, midpointBottom, color = midpointColor)
        midpointCandleLine := line.new(midX1, midpointFull, x0r, midpointFull, color = color.red)
    else
        line.set_xy1(midpointTopLine, midX1, midpointTop)
        line.set_xy2(midpointTopLine, x0r, midpointTop)
        line.set_xy1(midpointBottomLine, midX1, midpointBottom)
        line.set_xy2(midpointBottomLine, x0r, midpointBottom)
        line.set_xy1(midpointCandleLine, midX1, midpointFull)
        line.set_xy2(midpointCandleLine, x0r, midpointFull)
    line.set_color(midpointTopLine, showTopMidpoint ? midpointColor : color.new(midpointColor, 100))
    line.set_color(midpointBottomLine, showBottomMidpoint ? midpointColor : color.new(midpointColor, 100))
    line.set_color(midpointCandleLine, showCandleMidpoint ? color.red : color.new(color.red, 100))

    if showTfLabel
        string labelText = "GxT · " + contextTf + (autoTf ? " (Auto)" : " (Manual)") + " · Developing"
        float labelPrice = math.max(currH, math.max(prevH, math.max(prev2H, prev3H)))
        if na(timeframeLabel)
            timeframeLabel := label.new(x0r, labelPrice, labelText, style = label.style_none, textcolor = color.gray, size = size.small)
        else
            label.set_xy(timeframeLabel, x0r, labelPrice)
            label.set_text(timeframeLabel, labelText)
    else if not na(timeframeLabel)
        label.delete(timeframeLabel)
        timeframeLabel := na

// ── Context-period dividers ───────────────────────────────────────────────
bool newContextPeriod = ta.change(time(requestTf)) != 0
if barstate.isconfirmed and showDividers and validContextTf and newContextPeriod
    line divider = line.new(bar_index, low, bar_index, high, xloc = xloc.bar_index, extend = extend.both, color = dividerColor, style = line.style_dashed)
    array.push(dividerLines, divider)
    while array.size(dividerLines) > dividerHistory
        line.delete(array.shift(dividerLines))

// ── Next HTF close reference ──────────────────────────────────────────────
int contextCloseTime = validContextTf ? time_close(contextTf) : na
if barstate.islast and showDynamicClose and not na(contextCloseTime)
    if na(dynamicCloseLine)
        dynamicCloseLine := line.new(contextCloseTime, low, contextCloseTime, high, xloc = xloc.bar_time, extend = extend.both, color = dynamicCloseColor, style = line.style_solid, width = 2)
    else
        line.set_xy1(dynamicCloseLine, contextCloseTime, low)
        line.set_xy2(dynamicCloseLine, contextCloseTime, high)
        line.set_color(dynamicCloseLine, dynamicCloseColor)
else if barstate.islast and not na(dynamicCloseLine)
    line.delete(dynamicCloseLine)
    dynamicCloseLine := na

// PDH and PDL are previous daily-bar highs/lows; dotted lines originate at
// the previous daily candle close. PO3 candles are descriptive context only.
